{
  "name": "FullSend StarterPack",
  "image": "mcr.microsoft.com/devcontainers/python:3.14",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {},
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "version": "latest",
      "helm": "latest",
      "minikube": "none"
    },
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "1.16.5",
      "tflint": "none",
      "terragrunt": "none"
    }
  },
  "forwardPorts": [8000, 9090, 3000],
  "postCreateCommand": "python -m pip install -e '.[all]' && python -m playwright install --with-deps chromium",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "ms-playwright.playwright"]
    }
  }
}
