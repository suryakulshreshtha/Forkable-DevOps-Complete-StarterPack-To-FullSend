#!/bin/sh
# Git runs this before every commit. Git for Windows runs hooks with its own sh,
# so the same file works on macOS, Linux and Windows.
# Enable it once, from the repository root:  git config core.hooksPath phases/02-workflow/hooks
HOOK_DIR=$(dirname "$0")
if command -v python >/dev/null 2>&1; then PY=python; else PY=python3; fi
exec "$PY" "$HOOK_DIR/../commit_msg_check.py" "$1"
