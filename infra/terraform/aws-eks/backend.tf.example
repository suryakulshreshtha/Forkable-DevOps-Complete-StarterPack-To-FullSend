# Optional: keep state in S3 instead of on your laptop.
# Rename to backend.tf, create the bucket first (versioning on), then run `terraform init`.
# S3 native locking (use_lockfile) replaces the deprecated DynamoDB locking.
terraform {
  backend "s3" {
    bucket       = "your-unique-terraform-state-bucket"
    key          = "fullsend/eks/terraform.tfstate"
    region       = "us-east-1"
    use_lockfile = true
    encrypt      = true
  }
}
